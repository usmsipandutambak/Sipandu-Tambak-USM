# Monorepo .gitignore for SIPANDU-TAMBAK

# Android & Gradle
.gradle/
**/build/
local.properties
*.iml
.kotlin/

# IDE & Editors
.idea/
.vscode/
.settings/

# Python (Edge / Jetson)
__pycache__/
*.py[cod]
*$py.class
venv/
.env

# OS
.DS_Store
Thumbs.db
*.swp

# Arduino / ESP32 build output
firmware/build/
*.bin
*.hex
*.elf
